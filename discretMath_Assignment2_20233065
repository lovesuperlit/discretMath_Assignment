def relation_matrix() :
    print("5×5 정방 행렬을 입력 :")
    matrix = []
    for i in range(5) :
        row = list(map(int, input(f"{i+1}번째 행 : ").split()))
        if len(row) != 5 :
            raise ValueError("Error")
        matrix.append(row)
    return matrix

def print_matrix(M) :
    for row in M :
        print(row)

def is_reflexive(R) :
    for i in range(5) :
        if R[i][i] != 1 :
            return False
    return True

def is_symmetric(R) :
    for i in range(5) :
        for j in range(5) :
            if R[i][j] != R[j][i] :
                return False
    return True

def is_transitive(R) :
    for i in range(5) :
        for j in range(5) :
            if R[i][j] == 1 :
                for k in range(5) :
                    if R[j][k] == 1 and R[i][k] == 0 :
                        return False
    return True

def is_equivalence(R) :
    r = is_reflexive(R)
    s = is_symmetric(R)
    t = is_transitive(R)
    print(f"\n반사: {r}, 대칭: {s}, 추이: {t}")
    return r and s and t

def equivalence_class(R) :
    A = [1, 2, 3, 4, 5]
    classes = {}

    for i in range(5) :
        eq_class = []
        for j in range(5) :
            if R[i][j] == 1 :
                eq_class.append(A[j])
        classes[A[i]] = eq_class

    print("\n동치류 :")
    for e in classes :
        print(f"[{e}] = {classes[e]}")
    return classes

def reflexive_closure(R) :
    RC = [row[:] for row in R]
    for i in range(5) :
        RC[i][i] = 1
    return RC

def symmetric_closure(R) :
    SC = [row[:] for row in R]
    for i in range(5) :
        for j in range(5) :
            if R[i][j] == 1 :
                SC[j][i] = 1
    return SC

def transitive_closure(R) :
    TC = [row[:] for row in R]
    for k in range(5) :
        for i in range(5) :
            for j in range(5) :
                if TC[i][k] == 1 and TC[k][j] == 1 :
                    TC[i][j] = 1
    return TC

def equivalence_class_stats(classes) :
    
    unique_classes = []
    for cl in classes.values() :
        cl_set = set(cl)
        if cl_set not in unique_classes :
            unique_classes.append(cl_set)

    num_classes = len(unique_classes)

    sizes = [len(c) for c in unique_classes]
    max_size = max(sizes)
    min_size = min(sizes)

    print("\n동치류 통계 정보")
    print(f"동치류 개수 : {num_classes}")
    print(f"각 동치류 크기 : {sizes}")
    print(f"최대 동치류 크기 : {max_size}")
    print(f"최소 동치류 크기 : {min_size}")

def main():
    R = relation_matrix()

    print("\n관계 행렬 :")
    print_matrix(R)

    if is_equivalence(R):
        print("\n=> 이 관계는 동치 관계")
        classes = equivalence_class(R)          
        equivalence_class_stats(classes)        
        return
    else:
        print("\n=> 이 관계는 동치 관계 X")

    # 반사 폐포
    print("\n반사 폐포")
    RC = reflexive_closure(R)
    print("반사 폐포 변환 후 :")
    print_matrix(RC)
    print("동치 여부 :", is_equivalence(RC))
    classes = equivalence_class(RC)             
    equivalence_class_stats(classes)            

    # 대칭 폐포
    print("\n대칭 폐포")
    SC = symmetric_closure(R)
    print("대칭 폐포 변환 후 :")
    print_matrix(SC)
    print("동치 여부 :", is_equivalence(SC))
    classes = equivalence_class(SC)
    equivalence_class_stats(classes)

    # 추이 폐포
    print("\n추이 폐포")
    TC = transitive_closure(R)
    print("추이 폐포 변환 후 :")
    print_matrix(TC)
    print("동치 여부 :", is_equivalence(TC))
    classes = equivalence_class(TC)
    equivalence_class_stats(classes)

main()
